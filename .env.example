# Public Supabase project values (not service-role credentials).
# Set these securely in Vercel Project Settings, not in GitHub as real values.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Exact production origin, no trailing slash. Used for email confirmation callbacks.
NEXT_PUBLIC_APP_ORIGIN=https://your-deployment.vercel.app
